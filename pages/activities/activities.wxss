/**
 * 活动列表
 */
page { background: var(--bg); }

/* ===== 自定义顶栏 ===== */
.nav {
  position: sticky;
  top: 0;
  z-index: 50;
  background: var(--glass);
  backdrop-filter: saturate(180%) blur(20px);
  -webkit-backdrop-filter: saturate(180%) blur(20px);
  border-bottom: 1rpx solid var(--glass-line);
  box-shadow: 0 6rpx 20rpx rgba(32, 28, 74, 0.05);
}
.navbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  box-sizing: border-box;
  padding-left: 24rpx;
  gap: 14rpx;
}
.nav-city {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 64rpx;
  padding: 0 8rpx 0 4rpx;
  flex-shrink: 0;
  max-width: 170rpx;
}
.nav-city-name {
  font-size: var(--nav-title);
  font-weight: 700;
  color: var(--ink);
  line-height: 1.2;
  max-width: 128rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.city-caret {
  width: 0;
  height: 0;
  border-left: 9rpx solid transparent;
  border-right: 9rpx solid transparent;
  border-top: 11rpx solid var(--brand);
  opacity: 0.75;
  flex-shrink: 0;
  margin-top: 3rpx;
}
.city-press { opacity: 0.7; }
.nav-search-bar {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 66rpx;
  padding: 0 26rpx;
  background: rgba(83, 74, 183, 0.06);
  border: 1rpx solid rgba(83, 74, 183, 0.08);
  border-radius: 33rpx;
  min-width: 0;
  box-sizing: border-box;
}
.nav-search-bar:active { background: rgba(83, 74, 183, 0.12); }
.nav-search-bar .ic { font-size: var(--ic-md); opacity: 0.45; flex-shrink: 0; }
.nav-search-ph {
  font-size: 26rpx;
  color: var(--muted2);
  flex: 1;
  min-width: 0;
}

/* ===== 筛选 + 找搭子 banner ===== */
.act-header {
  padding: 18rpx 28rpx 22rpx;
  background: var(--card);
}
.filter-scroll { width: 100%; }
.filter-row {
  display: flex;
  gap: 12rpx;
  white-space: nowrap;
}
.act-filter {
  flex-shrink: 0;
  font-size: 25rpx;
  padding: 13rpx 28rpx;
  border-radius: 28rpx;
  background: var(--bg);
  color: var(--ink2);
  font-weight: 500;
  transition: background 0.2s, color 0.2s;
}
.act-filter.on {
  background: linear-gradient(135deg, #5B52C4 0%, var(--brand-dark) 100%);
  color: #fff;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(83, 74, 183, 0.28);
}

.buddy-banner {
  position: relative;
  overflow: hidden;
  margin-top: 20rpx;
  background: linear-gradient(135deg, #6459D6 0%, #3C3489 72%, #2E2868 100%);
  border-radius: 22rpx;
  padding: 26rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 10rpx 26rpx rgba(60, 52, 137, 0.26);
}
/* 右上柔光，增加体积感 */
.buddy-banner::after {
  content: '';
  position: absolute;
  right: -60rpx;
  top: -80rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}
.buddy-banner:active { opacity: 0.92; }
.buddy-banner-ic-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.buddy-banner-ic { font-size: var(--ic-lg); }
.buddy-banner-txt { flex: 1; color: #fff; min-width: 0; position: relative; z-index: 1; }
.buddy-banner-t { font-size: 28rpx; font-weight: 600; letter-spacing: 0.5rpx; }
.buddy-banner-s { font-size: 22rpx; opacity: 0.78; margin-top: 6rpx; }
.buddy-banner-arrow {
  color: rgba(255, 255, 255, 0.7);
  font-size: 40rpx;
  font-weight: 300;
  line-height: 1;
}

/* ===== 列表卡片 ===== */
.act-list {
  padding: 18rpx 24rpx 48rpx;
}
.act-card {
  background: var(--card);
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-2);
  transition: transform 0.15s, box-shadow 0.15s;
}
.act-card:active {
  transform: scale(0.985);
  box-shadow: var(--shadow-1);
}

.act-media {
  height: 320rpx;
  background: #FAFAFA;
  overflow: hidden;
  position: relative;
}
.act-media-img {
  width: 100%;
  height: 100%;
  display: block;
}
.act-ended {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: 22rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  z-index: 2;
}
.act-card.expired .act-media-img,
.act-card.expired .act-hero {
  filter: grayscale(0.45);
  opacity: 0.88;
}

/* 无封面：渐变头图 */
.act-hero {
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 40rpx;
  box-sizing: border-box;
  position: relative;
}
.act-hero-title {
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
  color: #fff;
  line-height: 1.4;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.25);
}

.act-body { padding: 24rpx 28rpx 28rpx; }
.act-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 14rpx;
}
.act-badge {
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.2;
  padding: 6rpx 14rpx;
  border-radius: 6rpx;
  background: var(--brand-bg);
  color: var(--brand);
  flex-shrink: 0;
}
.act-date {
  font-size: 22rpx;
  color: var(--muted);
  flex-shrink: 0;
}
.act-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.4;
  letter-spacing: -0.3rpx;
  margin-bottom: 12rpx;
}
.act-desc {
  font-size: 26rpx;
  color: var(--ink2);
  line-height: 1.55;
  margin-bottom: 16rpx;
}
.act-meta {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
}
.act-meta-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: var(--muted);
}
.act-meta-item .ic { font-size: var(--ic-sm); }
.act-status {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line2);
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}
.act-people { font-size: 23rpx; color: var(--muted); flex: 1; min-width: 0; }
.act-people-num { color: var(--brand); font-weight: 700; }
.act-people.tone-group { color: #FF6B35; font-weight: 600; }
.act-people.tone-group .act-people-num { color: #FF6B35; }
.act-people.tone-team { color: #2E7D32; font-weight: 600; }
.act-people.tone-team .act-people-num { color: #2E7D32; }
.act-btn-mini {
  height: 60rpx;
  padding: 0 26rpx;
  background: var(--brand);
  border-radius: 30rpx;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  flex-shrink: 0;
}
.act-btn-mini:active { opacity: 0.88; }
.act-btn-mini.ghost {
  background: #ececec;
  color: #8a8a8e;
}

.empty {
  text-align: center;
  padding: 120rpx 0;
  font-size: 26rpx;
  color: var(--muted);
}
.empty-icon { font-size: var(--ic-media); margin-bottom: 16rpx; }
.empty-link {
  margin-top: 16rpx;
  color: var(--brand);
  font-weight: 600;
}
