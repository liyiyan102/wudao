<view class="page">
  <view class="top-action" bindtap="goSubmit" hover-class="press">返回提交反馈</view>

  <view class="card" wx:for="{{list}}" wx:key="id">
    <view class="row">
      <view class="source">{{item.sourceName}}</view>
      <view class="status">{{item.statusName}}</view>
    </view>
    <view class="title" wx:if="{{item.sourceTitle}}">{{item.sourceTitle}}</view>
    <view class="content">{{item.content}}</view>
    <view class="meta">{{item.timeText}}</view>
  </view>

  <view class="empty" wx:if="{{!loading && !list.length}}">
    <view class="empty-icon">
      <view class="empty-bubble">
        <view></view>
        <view></view>
        <view></view>
      </view>
    </view>
    <view>还没有反馈记录</view>
    <view class="empty-sub">遇到问题或有建议，都可以告诉舞岛</view>
  </view>
</view>
