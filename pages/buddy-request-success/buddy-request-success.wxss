page { background: var(--card); }
.wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 64rpx;
}
.circle {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  background: var(--brand-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 48rpx;
}
.big { font-size: 80rpx; }
.h { font-size: 36rpx; font-weight: 700; margin-bottom: 16rpx; }
.sub {
  font-size: 26rpx;
  color: var(--muted);
  text-align: center;
  line-height: 1.7;
}
.sub2 {
  font-size: 26rpx;
  color: var(--muted);
  text-align: center;
  line-height: 1.7;
  margin-bottom: 56rpx;
}
.btn {
  width: 100%;
  height: 88rpx;
  background: var(--brand);
  border-radius: 16rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}
.link { font-size: 26rpx; color: var(--brand); font-weight: 600; }
