page { background: var(--bg); }
.list { padding: 24rpx; }
.card {
  background: var(--card);
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}
.row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; }
.st {
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}
.st-pending { background: #FFF3E0; color: #E65100; }
.st-rejected { background: #FFEBEE; color: #FA5151; }
.st-published { background: #E8F5E9; color: #2E7D32; }
.st-closed { background: var(--line2); color: var(--muted); }
.time { font-size: 22rpx; color: var(--muted2); }
.title { font-size: 30rpx; font-weight: 600; margin-bottom: 8rpx; }
.meta { font-size: 24rpx; color: var(--muted); }
.reason { font-size: 24rpx; color: #FA5151; margin-top: 12rpx; }
.acts { display: flex; flex-wrap: wrap; gap: 24rpx; margin-top: 20rpx; }
.lnk { font-size: 24rpx; color: var(--brand); font-weight: 600; }
.lnk.danger { color: #FA5151; }

.empty { text-align: center; padding: 140rpx 0; font-size: 26rpx; color: var(--muted); }
.empty-icon { font-size: var(--ic-media); margin-bottom: 16rpx; }
.empty-link { margin-top: 16rpx; color: var(--brand); font-weight: 600; }
