@import "../index/index.wxss";

/* 顶栏：返回 + 居中「搜索」 */
.search-top {
  box-sizing: border-box;
  position: relative;
  display: flex;
  align-items: center;
  padding-left: 12rpx;
}
.back-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  z-index: 1;
  border-radius: 50%;
}
.back-btn:active { background: rgba(83, 74, 183, 0.1); }
.back-btn .ic { font-size: var(--ic-lg); }
.search-title {
  position: absolute;
  left: 0;
  right: 0;
  text-align: center;
  font-size: var(--nav-title);
  font-weight: 600;
  color: var(--ink);
  line-height: 1.2;
  pointer-events: none;
  letter-spacing: 1rpx;
}

/* 搜框行 */
.search-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 4rpx 28rpx 20rpx;
  box-sizing: border-box;
}
.search-bar {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(83, 74, 183, 0.06);
  border: 1rpx solid rgba(83, 74, 183, 0.08);
  border-radius: 36rpx;
  height: 72rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
}
.search-ic { font-size: var(--ic-md); opacity: 0.45; }
.search-input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--ink);
}
.ph { color: var(--muted2); }
.clear-btn { font-size: var(--ic-md); padding: 8rpx; opacity: 0.5; }

.search-btn {
  font-size: 28rpx;
  color: var(--brand);
  font-weight: 600;
  padding: 12rpx 8rpx;
  flex-shrink: 0;
}
.search-btn:active { opacity: 0.7; }

/* 初始态 */
.init-panel {
  padding: 8rpx 32rpx 48rpx;
}
.sec-h {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 20rpx;
}
.sec-h .ic-trash { font-size: var(--ic-md); opacity: 0.45; padding: 8rpx; }
.sec-h .ic-fire-brand { font-size: var(--ic-md); }
.sec-gap { margin-top: 44rpx; }

.history-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.hist-tag {
  font-size: 24rpx;
  color: var(--ink2);
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 28rpx;
  padding: 14rpx 26rpx;
}
.hist-tag:active { background: var(--bg); }

.hot-list {
  display: flex;
  flex-direction: column;
  background: #fff;
  border-radius: 20rpx;
  padding: 8rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(26, 26, 26, 0.04);
}
.hot-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 4rpx;
  font-size: 28rpx;
  color: var(--ink);
}
.hot-item + .hot-item { border-top: 1rpx solid var(--line2); }
.hot-item:active { opacity: 0.7; }
.hot-no {
  width: 40rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--muted2);
  text-align: center;
  font-variant-numeric: tabular-nums;
}
.hot-no-top { color: var(--brand); }
.hot-word { flex: 1; min-width: 0; }
.hot-tag {
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: var(--brand-bg);
  color: var(--brand-dark);
}

/* 结果态 */
.result-panel {
  padding: 8rpx 0 60rpx;
}
.result-count {
  font-size: 22rpx;
  color: var(--muted2);
  padding: 8rpx 32rpx 16rpx;
}

/* 空结果态 */
.empty-panel {
  padding: 120rpx 32rpx;
  text-align: center;
}
.empty-icon { font-size: var(--ic-media); margin-bottom: 20rpx; opacity: 0.6; }
.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}
.empty-sub {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 10rpx;
}
.retry-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 14rpx;
  margin-top: 40rpx;
}

/* 搜索结果封面 */
.cover-wrap {
  display: inline-flex;
  max-width: 100%;
  height: 340rpx;
  background: transparent;
  border-radius: 14rpx;
  margin-top: 16rpx;
  overflow: hidden;
  line-height: 0;
  align-items: center;
}
.cover-img {
  height: 100%;
  width: auto;
  max-width: 100%;
  display: block;
  border-radius: 14rpx;
}
.cat-tag {
  display: inline-flex;
  font-size: 20rpx;
  font-weight: 600;
  color: #3C3489;
  background: #EEEDFE;
  border-radius: 6rpx;
  padding: 4rpx 14rpx;
  margin-bottom: 12rpx;
}
.cat-tag.c2 { color: #2E7D32; background: #E8F5E9; }
.cat-tag.c3 { color: #E65100; background: #FFF3E0; }
.cat-tag.c4 { color: #1565C0; background: #E3F2FD; }
.cat-tag.c5 { color: #C62828; background: #FFE7E0; }
.cat-tag.c6 { color: #00838F; background: #E0F7FA; }
.post-summary {
  font-size: 26rpx;
  color: var(--muted);
  line-height: 1.55;
  margin-top: 12rpx;
}
