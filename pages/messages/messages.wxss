page { background: var(--bg); }
.list { padding: 24rpx; }
.card {
  background: var(--card);
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}
.card.unread {
  box-shadow: inset 6rpx 0 0 var(--brand);
}
.row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; }
.st {
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}
.st-published { background: #E8F5E9; color: #2E7D32; }
.st-rejected { background: #FFEBEE; color: #FA5151; }
.time { font-size: 22rpx; color: var(--muted2); }
.title { font-size: 30rpx; font-weight: 600; margin-bottom: 8rpx; }
.body { font-size: 24rpx; color: var(--ink2); line-height: 1.5; }
.hint { font-size: 22rpx; color: var(--brand); margin-top: 16rpx; font-weight: 600; }
.empty { text-align: center; padding: 140rpx 0; font-size: 26rpx; color: var(--muted); }
.empty-icon { font-size: var(--ic-media); margin-bottom: 16rpx; }
.empty-sub { margin-top: 12rpx; font-size: 22rpx; color: var(--muted2); }
