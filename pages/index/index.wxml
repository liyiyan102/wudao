<!-- 自定义顶栏：搜索与分类同一行垂直居中（设计稿 appbar） -->
<view class="nav" style="padding-top:{{statusBarHeight}}px">
  <view class="navbar" style="height:{{navBarHeight}}px;padding-right:{{capsuleRight}}px">
    <view class="nav-search" bindtap="goSearch">
      <view class="ic ic-search-muted"></view>
    </view>
    <scroll-view scroll-x class="toptabs" enable-flex>
      <view
        wx:for="{{tabs}}"
        wx:key="key"
        class="toptab {{scope === item.key ? 'on' : ''}}"
        style="height:{{navBarHeight}}px"
        bindtap="switchTab"
        data-key="{{item.key}}"
      >
        <block wx:if="{{item.key === 'city'}}">
          <text class="city-tab-name">{{city}}</text>
          <view class="city-dd" catchtap="goCityPick">
            <view class="city-caret"></view>
          </view>
        </block>
        <text wx:else>{{item.name}}</text>
        <view class="indicator" wx:if="{{scope === item.key}}"></view>
      </view>
    </scroll-view>
  </view>
</view>

<view class="feed">
  <view class="card card-press" wx:for="{{posts}}" wx:key="id" bindtap="openPost" data-id="{{item.id}}">
    <view class="cat {{item.tagCls}}">{{item.catName}}</view>
    <view class="post-title">{{item.title}}</view>

    <view class="cover-wrap" wx:if="{{item.coverUrl}}">
      <image class="cover-img" src="{{item.coverUrl}}" mode="heightFix" lazy-load="{{true}}" />
    </view>
    <view class="post-summary ellipsis-2" wx:elif="{{item.summary}}">{{item.summary}}</view>

    <view class="meta-row">
      <image wx:if="{{item.pubAvatar}}" class="avatar-img av-18" src="{{item.pubAvatar}}" mode="aspectFill" />
      <view wx:else class="avatar av-18">{{item.nickInitial}}</view>
      <text class="meta-name">{{item.pubName}}</text>
      <text class="meta-dot">·</text>
      <text class="meta-time">{{item.timeText}}</text>
    </view>
  </view>

  <view class="empty" wx:if="{{loading && !posts.length}}">加载中…</view>
  <view class="empty" wx:elif="{{errorMsg && !posts.length}}">
    <view>{{errorMsg}}</view>
    <view class="retry" bindtap="reloadFeed">点此重试</view>
  </view>
  <view class="empty" wx:elif="{{!posts.length}}">
    {{scope === 'city' ? city + '还没有内容，去「发现」逛逛吧' : '该分类下暂无内容'}}
  </view>
</view>

<!-- 潮流黑金 / 街舞票根风格浮动入口 -->
<view class="persona-dock {{personaFabVisible ? '' : 'is-hidden'}} {{personaFabExpanded ? 'is-expanded' : 'is-collapsed'}}">
  <view class="persona-tag" bindtap="goPersonaTest">
    <view class="tag-accent-bar"></view>
    <view class="tag-slot tag-slot-full">
      <view class="tag-content">
        <view class="tag-badge">TEST</view>
        <view class="tag-text">
          <text class="tag-title">你的街舞人格</text>
          <text class="tag-sub">9 题，看你是圈里哪一种 ➔</text>
        </view>
      </view>
    </view>
    <view class="tag-slot tag-slot-mini">
      <view class="tag-mini">
        <text class="dot">●</text>
        <text class="tag-mini-label">街舞人格</text>
      </view>
    </view>
  </view>
  <view class="persona-close" catchtap="closePersonaFab">
    <text class="persona-close-x">×</text>
  </view>
</view>

