page { background: var(--bg); height: 100%; }
.page {
  height: 100%;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.search-wrap {
  background: #fff;
  padding: 16rpx 28rpx 20rpx;
  flex-shrink: 0;
}
.search-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 72rpx;
  padding: 0 24rpx;
  background: var(--bg);
  border-radius: 36rpx;
}
.search-ic { font-size: var(--ic-md); opacity: 0.45; }
.search-input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--ink);
}
.ph { color: var(--muted2); }
.clear { font-size: 28rpx; opacity: 0.45; padding: 8rpx; }

.main {
  flex: 1;
  min-height: 0;
  position: relative;
  display: flex;
}
.body {
  flex: 1;
  height: 100%;
  padding: 8rpx 56rpx 0 28rpx;
  box-sizing: border-box;
}

.sec { margin-bottom: 28rpx; }
.sec-h {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 18rpx;
}
.sec-clear {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: var(--muted);
}
.sec-clear .ic { font-size: var(--ic-sm); opacity: 0.5; }

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.chip {
  min-width: 140rpx;
  height: 64rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  background: #fff;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: var(--ink2);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}
.chip:active { opacity: 0.75; }
.chip-on {
  background: var(--brand-bg);
  color: var(--brand);
  font-weight: 600;
}
.chip-now {
  background: #fff;
  color: var(--brand);
  border: 1rpx solid var(--brand-pale);
}
.chip-ic { font-size: var(--ic-sm); }

.letter-block { margin-bottom: 8rpx; }
.letter-h {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--muted);
  background: var(--bg);
  padding: 12rpx 0;
  position: sticky;
  top: 0;
  z-index: 2;
}
.city-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  padding: 26rpx 8rpx;
  background: #fff;
  border-bottom: 1rpx solid var(--line2);
}
.city-row:active { background: var(--bg); }
.city-name { font-size: 28rpx; color: var(--ink); }
.city-prov { font-size: 22rpx; color: var(--muted2); }

.index {
  position: absolute;
  right: 4rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 5;
  padding: 8rpx 0;
}
.index-item {
  font-size: 18rpx;
  color: var(--brand);
  font-weight: 600;
  line-height: 1.55;
  padding: 0 10rpx;
}

.empty {
  text-align: center;
  padding: 120rpx 0;
  color: var(--muted);
  font-size: 26rpx;
}
.safe-bottom { height: 80rpx; }
