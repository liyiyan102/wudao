.page {
  min-height: 100%;
  padding: 72rpx 48rpx 80rpx;
  box-sizing: border-box;
  background: var(--bg);
}

.lead-title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--ink);
}
.lead-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--muted);
}

.avatar-btn {
  margin: 64rpx auto 48rpx;
  width: 168rpx;
  height: 168rpx;
  min-width: 168rpx;
  max-width: 168rpx;
  padding: 0;
  line-height: 1;
  border-radius: 50%;
  overflow: hidden;
  background: var(--brand-bg);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.avatar-btn::after { border: none; }
.avatar-img {
  width: 168rpx;
  height: 168rpx;
  display: block;
  border-radius: 50%;
}
.avatar-ph {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  color: var(--brand);
  font-size: 22rpx;
}
.avatar-ph .ic { font-size: 48rpx; }

.field {
  background: var(--card);
  border-radius: 20rpx;
  padding: 8rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.field-label {
  font-size: 26rpx;
  color: var(--muted);
  flex-shrink: 0;
}
.field-input {
  flex: 1;
  height: 88rpx;
  font-size: 30rpx;
  color: var(--ink);
}

.submit {
  margin-top: 48rpx;
  margin-left: 0;
  margin-right: 0;
  width: 100%;
  height: 96rpx;
  padding: 0;
  line-height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #5B52C4 0%, var(--brand-dark) 100%);
  box-shadow: 0 10rpx 24rpx rgba(83, 74, 183, 0.32);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.submit::after { border: none; }
.submit[disabled] { opacity: 0.55; }

.hint {
  margin-top: 28rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--muted2);
}
.link { color: var(--brand); }
